# ==========================================
# FERYSHOP MONITORING STACK ENVIRONMENT
# ==========================================

# 1. Grafana Credentials & Settings
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=feryshop_secure_password_2026
GRAFANA_ROOT_URL=http://localhost:3001

# 2. Supabase PostgreSQL Connection (Direct URL atau Pooler port 5432)
# Format: postgresql://postgres.[project-ref]:[db-password]@[db-host]:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# 3. Nginx Gateway Stub Status URL
# Jika di dalam docker network yang sama dengan Nginx:
NGINX_STATUS_URL=http://fs-nginxgateway:8080/stub_status
